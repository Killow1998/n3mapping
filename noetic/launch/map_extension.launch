<launch>
  <node pkg="n3mapping" type="n3mapping_node" name="n3mapping_node" output="screen">
    <env name="OMP_WAIT_POLICY" value="$(optenv OMP_WAIT_POLICY PASSIVE)" />
    <rosparam file="$(find n3mapping)/config/n3mapping.yaml" command="load" />
    <rosparam file="$(find n3mapping)/config/map_extension.yaml" command="load" />
  </node>
  <node pkg="n3mapping" type="yaml_arguments.py" name="n3_rviz" output="screen"
        args="&quot;$(find n3mapping)/config/launch_noetic.yaml&quot; visualization" />
</launch>
