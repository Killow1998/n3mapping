<launch>
  <node pkg="n3mapping" type="yaml_arguments.py"
        name="n3mapping_synthetic_relocalization_visualizer" output="screen"
        args="&quot;$(find n3mapping)/config/launch_noetic.yaml&quot; synthetic" />
  <node pkg="n3mapping" type="yaml_arguments.py" name="n3_synthetic_rviz" output="screen"
        args="&quot;$(find n3mapping)/config/launch_noetic.yaml&quot; synthetic_visualization" />
</launch>
