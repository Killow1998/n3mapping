<launch>
  <node pkg="n3mapping" type="yaml_arguments.py" name="n3mapping_node" output="screen"
        args="&quot;$(find n3mapping)/config/launch_noetic.yaml&quot; product">
    <env name="OMP_WAIT_POLICY" value="$(optenv OMP_WAIT_POLICY PASSIVE)" />
  </node>
  <node pkg="n3mapping" type="yaml_arguments.py" name="n3_rviz" output="screen"
        args="&quot;$(find n3mapping)/config/launch_noetic.yaml&quot; product_visualization" />
</launch>
